# ThreadScout AI — Environment Configuration Template (Zero Real Secrets)
# Copy to `.env` locally or inject via your container/cloud secret manager.

# 1. Surface & Network Posture (`local_dev` | `combined` | `public_showcase`)
# - `local_dev`: Loopback-only (`127.0.0.1`), non-production local studio.
# - `combined`: Public `/showcase` + token/cookie-protected Operator Studio (`/`).
# - `public_showcase`: Read-only `/showcase` ONLY (all operator routes & static files disabled).
THREADSCOUT_SURFACE_MODE=local_dev
THREADSCOUT_BIND_HOST=127.0.0.1
PORT=4173

# 2. Operator Studio Authentication (REQUIRED when `THREADSCOUT_SURFACE_MODE=combined`, minimum 16 chars)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
THREADSCOUT_OPERATOR_TOKEN=
# Optional separate HMAC session signing key (>= 16 chars); if omitted, an ephemeral 256-bit CSPRNG key is generated per server start
THREADSCOUT_SESSION_SECRET=
THREADSCOUT_SESSION_TTL_SECONDS=43200
# Set to `true` ONLY when running behind a trusted reverse proxy (Cloudflare Tunnel / Caddy / Nginx / Fly.io)
THREADSCOUT_TRUST_PROXY=false

# 3. Storage & Emergency Controls
THREADSCOUT_STORAGE_MODE=sqlite
THREADSCOUT_DATA_DIR=.threadscout-data
# Set to `true` to immediately halt mutations and withdraw `/showcase` cards (`503` / empty list)
THREADSCOUT_GLOBAL_KILL_SWITCH=false

# 4. Future Live API Gates (Keep empty until explicit live-activation preflight passes)
THREADS_APP_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
