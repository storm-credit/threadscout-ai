{
  "name": "threadscout-ai",
  "private": true,
  "version": "0.0.0",
  "description": "Approval-first product discovery and content operations for Threads.",
  "scripts": {
    "check:docs": "node scripts/check-docs.mjs",
    "check:governance": "node scripts/check-governance-and-floor.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node apps/web/server.mjs",
    "start:showcase": "node apps/web/server.mjs --surface=public_showcase",
    "orchestra:demo": "node scripts/demo-orchestra.mjs",
    "orchestra:simulate": "node scripts/simulate-sinbak-orchestra.mjs",
    "orchestra:replay": "node scripts/run-replay-runtime.mjs",
    "orchestra:store": "node scripts/run-versioned-store.mjs",
    "harness:spike0": "node scripts/run-master-harness-spike0.mjs",
    "research:fixture": "node scripts/run-fixture-research.mjs",
    "research:readiness": "node scripts/report-live-source-readiness.mjs",
    "preflight:live": "node scripts/check-live-preflight.mjs",
    "verify": "npm run check:docs && npm run check:governance && npm test && npm run orchestra:simulate && npm run orchestra:replay && npm run orchestra:store && npm run harness:spike0 && npm run research:fixture && npm run research:readiness && npm run preflight:live"
  },
  "engines": {
    "node": ">=20"
  }
}
